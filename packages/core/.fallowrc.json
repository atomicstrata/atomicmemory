{
  "$schema": "https://fallow.tools/schema.json",
  "entry": [
    "hosted/migration-history-overlay.mjs",
    "hosted/__tests__/migration-history-overlay.test.mjs"
  ],
  "ignorePatterns": [
    "**/one-offs/**",
    "scripts/**"
  ],
  "ignoreDependencies": [
    "@helia/verified-fetch",
    "@helia/unixfs",
    "blockstore-core",
    "filecoin-pin",
    "pino",
    "yaml"
  ],
  "rules": {
    "unused-types": "off",
    "unused-class-members": "off",
    "duplicate-exports": "off"
  },
  "duplicates": {
    "ignore": [
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.mjs",
      "tests/**",
      "scripts/**"
    ]
  }
}
